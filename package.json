{
  "name": "parking-manager",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "reset-password": "tsx scripts/reset-password.ts",
    "license:init": "tsx scripts/license/keygen.ts init",
    "license:create": "tsx scripts/license/keygen.ts create",
    "desktop:icon": "node scripts/desktop/make-icon.mjs",
    "desktop:bundle": "node scripts/desktop/bundle.mjs",
    "desktop:start": "npm run build && npm run desktop:bundle && electron .",
    "desktop:dist": "npm run build && npm run desktop:icon && npm run desktop:bundle && electron-builder --win nsis --x64",
    "license:app": "node scripts/desktop/make-icon.mjs && node scripts/desktop/bundle-keygen.mjs && electron build-keygen/main.mjs",
    "license:app:dist": "node scripts/desktop/make-icon.mjs && node scripts/desktop/bundle-keygen.mjs && electron-builder --config keygen-builder.json --win portable --x64"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "embedded-postgres": "18.7.0-beta.19",
    "express": "^4.21.2",
    "html-to-image": "^1.11.11",
    "jspdf": "^2.5.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Parking Manager — gestion de parkings multi-sites",
  "author": "Parking Manager",
  "main": "build/main.mjs",
  "build": {
    "appId": "mg.parkingmanager.desktop",
    "productName": "Parking Manager",
    "copyright": "Parking Manager",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "package.json",
      "build/**/*",
      "dist/**/*",
      "database/**/*",
      "build-resources/icon.png",
      "!node_modules/**/*",
      "node_modules/@embedded-postgres/windows-x64/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "Parking-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Parking Manager",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "deleteAppDataOnUninstall": false
    }
  }
}
